// Fuente del diagrama completo; las etiquetas agrupadas expanden las 36 reglas.
digraph MaquinaTuring {
    graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.65", ranksep="1.05",
           fontname="Arial", fontsize=22, labelloc=t,
           label="Máquina de Turing determinista · una cinta\nAcepta 0ⁿ1ⁿ (n ≥ 1) · entra en ciclo si la entrada empieza con 2"];
    node [shape=circle, fontname="Arial", fontsize=14, color="#263b53", penwidth=1.6,
          style=filled, fillcolor="#edf4fb", margin="0.12"];
    edge [fontname="Consolas", fontsize=12, color="#415b77", fontcolor="#263b53", arrowsize=0.85];

    inicio [shape=point, width=0.1, label="", fillcolor="#263b53"];
    q0 [label="q0"];
    qBusca1 [label="qBusca1"];
    qRegresa [label="qRegresa"];
    qVerifica [label="qVerifica"];
    qIda [label="qIda", fillcolor="#fff1d6"];
    qVuelta [label="qVuelta", fillcolor="#fff1d6"];
    qAcepta [shape=doublecircle, label="qAcepta\nACEPTACIÓN", fillcolor="#e3f4e8", color="#277346"];
    qRechaza [shape=doublecircle, label="qRechaza\nRECHAZO", fillcolor="#fbe7e5", color="#aa3c35"];

    inicio -> q0;
    q0 -> q0 [label="X/X, R"];
    q0 -> qBusca1 [label="0/X, R"];
    qBusca1 -> qBusca1 [label="0/0, R\nY/Y, R"];
    qBusca1 -> qRegresa [label="1/Y, L"];
    qRegresa -> qRegresa [label="a/a, L\na en {0,1,X,Y}"];
    qRegresa -> q0 [label="_/_, R", constraint=false];
    q0 -> qVerifica [label="Y/Y, R"];
    qVerifica -> qVerifica [label="Y/Y, R"];
    qVerifica -> qAcepta [label="_/_, R", color="#277346"];

    q0 -> qIda [label="2/2, R", color="#a47418"];
    qIda -> qVuelta [label="a/a, R; a en Γ", color="#a47418"];
    qVuelta -> qIda [label="a/a, L; a en Γ", color="#a47418"];

    q0 -> qRechaza [label="1/1, R\n_/_, R", color="#aa3c35", fontcolor="#aa3c35"];
    qBusca1 -> qRechaza [label="a/a, R\na en {2,X,_}", color="#aa3c35", fontcolor="#aa3c35"];
    qRegresa -> qRechaza [label="2/2, R", color="#aa3c35", fontcolor="#aa3c35"];
    qVerifica -> qRechaza [label="a/a, R\na en {0,1,2,X}", color="#aa3c35", fontcolor="#aa3c35"];

    leyenda [shape=plain, style="", label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5">
        <TR><TD ALIGN="LEFT"><B>Notación de cada arista: leer/escribir, movimiento</B></TD></TR>
        <TR><TD ALIGN="LEFT">R: derecha · L: izquierda · _: blanco</TD></TR>
        <TR><TD ALIGN="LEFT">Γ = {0, 1, 2, X, Y, _}</TD></TR>
        <TR><TD ALIGN="LEFT">a/a con a en S representa una regla por cada símbolo de S.</TD></TR>
        <TR><TD ALIGN="LEFT">X marca un 0 procesado; Y marca un 1 procesado.</TD></TR>
        <TR><TD ALIGN="LEFT">Los estados finales no tienen transiciones salientes.</TD></TR>
        </TABLE>
    >];
}
